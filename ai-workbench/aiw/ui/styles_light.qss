/* Global Light Theme */
QMainWindow, QWidget {
  background-color: #ffffff;
  color: #1f2430;
  font-family: "Cascadia Code", "Cascadia Mono", "Segoe UI", "Inter", system-ui, -apple-system, sans-serif;
  font-size: 11pt;
}

QDockWidget::title {
  background: #eef1f5;
  padding: 6px 10px;
  color: #3a4354;
  font-weight: 600;
  border-bottom: 1px solid #d7dde6;
}

QTreeView, QTreeWidget {
  background: #ffffff;
  border: 1px solid #d7dde6;
  border-radius: 8px;
}
QTreeView::item:selected, QTreeWidget::item:selected {
  background: #dfe9ff;
  color: #1f2430;
}

QTextEdit, QLineEdit, QTextBrowser {
  background: #ffffff;
  border: 1px solid #d7dde6;
  border-radius: 10px;
  padding: 6px 10px;
  selection-background-color: #2b84ff;
}

/* Editors and diff viewers */
QTextEdit#CodeEditor, QTextEdit#DiffViewer {
  background: #ffffff;
  color: #1f2430;
  border: 1px solid #d7dde6;
  border-radius: 8px;
  padding: 8px;
  selection-background-color: #2b84ff;
  font-family: "Cascadia Code", "Cascadia Mono", Consolas, monospace;
  font-size: 11pt;
}
QTextEdit#CodeEditor:focus, QTextEdit#DiffViewer:focus { border-color: #2b84ff; }

QPushButton {
  background-color: #ffffff;
  color: #1f2430;
  border: 1px solid #cfd6e1;
  padding: 6px 12px;
  border-radius: 10px;
}
QPushButton:hover { background-color: #f1f4f8; }
QPushButton:pressed { background-color: #e8edf4; }

QTabWidget::pane { border-top: 1px solid #d7dde6; }
QTabBar::tab {
  background: #eef1f5;
  color: #3a4354;
  padding: 6px 14px;
  border-top-left-radius: 10px;
  border-top-right-radius: 10px;
  margin-right: 6px;
}
QTabBar::tab:selected { background: #ffffff; color: #1f2430; }

QSplitter::handle { background: #eef1f5; }
QSplitter::handle:horizontal { width: 6px; }
QSplitter::handle:vertical { height: 6px; }

/* ChatConsole */
QScrollArea#ChatScroll { border: none; }

QFrame#BubbleContainer[msgRole="user"] {
  background: #e917d8ff;
  border: 1px solid #092f64ff;
  border-radius: 14px;
}
QLabel#BubbleHeader[msgRole="user"] { color: #1a4e8a; font-weight: 600; }
QTextBrowser#BubbleBody[msgRole="user"] { color: #0d2240; }

QFrame#BubbleContainer[msgRole="assistant"] {
  background: #1a2ee2ff;
  border: 1px solid #0f3e85ff;
  border-radius: 14px;
}
QLabel#BubbleHeader[msgRole="assistant"] { color: #0f5132; font-weight: 600; }
QTextBrowser#BubbleBody[msgRole="assistant"] { color: #1f2430; }

QFrame#BubbleContainer[msgRole="system"] {
  background: #eb0c1fff;
  border: 1px solid #ffcdc4;
  border-radius: 14px;
}
QLabel#BubbleHeader[msgRole="system"] { color: #b02a37; font-weight: 700; }
QTextBrowser#BubbleBody[msgRole="system"] { color: #5f1a1e; }

QStatusBar {
  background: #f7f8fa;
  border-top: 1px solid #d7dde6;
  color: #3a4354;
}

QTextBrowser { font-size: 10.5pt; }

/* Diff view title label */
QLabel#titleLabel {
  color: #1f2430;
  font-size: 14px;
  font-weight: 600;
  padding: 6px 12px;
  background: #f7f8fa;
  border: 1px solid #d7dde6;
  border-radius: 6px;
}

/* Code editor file label */
QLabel#fileLabel {
  color: #1f2430;
  font-size: 12px;
  font-weight: 600;
  padding: 6px 12px;
  background: #f7f8fa;
  border: 1px solid #d7dde6;
  border-radius: 6px;
}
/* Reasoning panel */
QTextBrowser#ReasoningView {
  background: #f7f8fa;
  border: 1px solid #d7dde6;
  border-radius: 6px;
  font-size: 11px;
  padding: 6px;
}

/* PaneManager status footer */
QFrame#PaneStatus {
  background: #ffffff;
  border-top: 1px solid #d7dde6;
}

/* Plan tab */
QListWidget#planList {
  font-family: "Cascadia Code", Consolas, monospace;
  font-size: 11px;
}

/* Exec output */
QTextBrowser#execOutputView {
  font-family: "Cascadia Code", Consolas, monospace;
  font-size: 11px;
}

/* Chat toolbar labels */
QLabel#TypingLabel, QLabel#TokenLabel {
  color: #6b7280;
  font-size: 11px;
}
QLabel#ChatCountLabel {
  color: #6b7280;
  font-size: 10px;
}
