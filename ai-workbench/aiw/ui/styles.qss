/* Global Dark Theme */
QMainWindow, QWidget {
  background-color: #0f131a;
  color: #e6e8eb;
  font-family: "Cascadia Code", "Cascadia Mono", "Segoe UI", "Inter", system-ui, -apple-system, sans-serif;
  font-size: 11pt;
}

QDockWidget {
  titlebar-close-icon: url(none);
  titlebar-normal-icon: url(none);
}

QDockWidget::title {
  background: #111721;
  padding: 6px 10px;
  color: #aeb3bb;
  font-weight: 600;
  border-bottom: 1px solid #1c2533;
}

QTreeView, QTreeWidget {
  background: #0f131a;
  border: 1px solid #1c2533;
  border-radius: 8px;
}
QTreeView::item:selected, QTreeWidget::item:selected {
  background: #1f2a3a;
  color: #e6e8eb;
}

QTextEdit, QLineEdit, QTextBrowser {
  background: #0f131a;
  border: 1px solid #1c2533;
  border-radius: 10px;
  padding: 6px 10px;
  selection-background-color: #2b84ff;
}

QPushButton {
  background-color: #1a2230;
  color: #e6e8eb;
  border: 1px solid #263146;
  padding: 6px 12px;
  border-radius: 10px;
}
QPushButton:hover {
  background-color: #223046;
}
QPushButton:pressed {
  background-color: #2a3a55;
}

QTabWidget::pane {
  border-top: 1px solid #1c2533;
}
QTabBar::tab {
  background: #141a24;
  color: #aeb3bb;
  padding: 6px 14px;
  border-top-left-radius: 10px;
  border-top-right-radius: 10px;
  margin-right: 6px;
}
QTabBar::tab:selected {
  background: #1a2230;
  color: #e6e8eb;
}

QToolBar {
  background: #0f131a;
  border-bottom: 1px solid #1c2533;
  spacing: 6px;
  padding: 6px 8px;
}
QToolBar QToolButton {
  background: #151d2a;
  color: #e6e8eb;
  border: 1px solid #263146;
  border-radius: 8px;
  padding: 6px 10px;
}
QToolBar QToolButton:hover { background: #1b2739; }
QToolBar QToolButton:pressed { background: #233149; }

/* Splitter handle */
QSplitter::handle { background: #151b26; }
QSplitter::handle:horizontal { width: 6px; }
QSplitter::handle:vertical { height: 6px; }

/* ChatConsole */
QScrollArea#ChatScroll { border: none; }

QStatusBar {
  background: #0f131a;
  border-top: 1px solid #1c2533;
  color: #aeb3bb;
}

QFrame#BubbleContainer[msgRole="user"] {
  background: #1f3a5a;
  border: 1px solid #2a4a74;
  border-radius: 14px;
}
QLabel#BubbleHeader[msgRole="user"] {
  color: #9ecbff;
  font-weight: 600;
  letter-spacing: 0.2px;
}
QTextBrowser#BubbleBody[msgRole="user"] { color: #dbeafe; }

QFrame#BubbleContainer[msgRole="assistant"] {
  background: #18222f;
  border: 1px solid #263146;
  border-radius: 14px;
}
QLabel#BubbleHeader[msgRole="assistant"] {
  color: #a7f3d0;
  font-weight: 600;
}
QTextBrowser#BubbleBody[msgRole="assistant"] { color: #e6e8eb; }

QFrame#BubbleContainer[msgRole="system"] {
  background: #2a1a1a;
  border: 1px solid #5a2a2a;
  border-radius: 14px;
}
QLabel#BubbleHeader[msgRole="system"] {
  color: #ffb4a5;
  font-weight: 700;
}
QTextBrowser#BubbleBody[msgRole="system"] { color: #ffd1c7; }

/* Monospace blocks inside messages */
QTextBrowser { font-size: 10.5pt; }
QTextBrowser pre, QTextBrowser code {
  font-family: "Cascadia Code", "Consolas", "Fira Code", monospace;
}
